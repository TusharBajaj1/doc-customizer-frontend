# Optional. Lets the /request page create GitHub issues directly.
# Create a fine-grained token limited to this one repository with "Issues: Read and write".
# FEEDBACK_GITHUB_TOKEN=
# FEEDBACK_REPO=TusharBajaj1/doc-customizer-frontend

# Optional. Used for sitemap/canonical URLs (Vercel sets a default automatically).
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional. URL of the deployed /converter service. Enables the Office to PDF tool; unset = tool hidden.
# NEXT_PUBLIC_CONVERTER_URL=https://pdfrookie-converter.fly.dev

# Optional. Public contact email shown on the About page (e.g. hello@pdfrookie.org). Unset = not shown.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Loaded only after the visitor accepts the banner. Unset = no analytics.
# NEXT_PUBLIC_GA_ID=
